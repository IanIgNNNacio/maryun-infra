# Todo lo que se copia al servidor tiene que quedar con finales de linea LF.
# Un script con CRLF falla en Linux con un error opaco: `bad interpreter:
# /usr/bin/env bash^M`. La copia de trabajo en Windows convierte a CRLF salvo
# que se diga lo contrario aqui.
*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
Dockerfile  text eol=lf
