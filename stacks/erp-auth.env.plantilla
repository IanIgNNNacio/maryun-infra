# Plantilla de /srv/secrets/erp-auth.env — QUE claves hacen falta, nunca con que
# valores. El acceso local del ERP (contrasena, codigo al correo, segundo
# factor) las lee desde Coolify; este archivo es la copia escrita del servidor.
#
# Generar cada una con:
#   head -c 48 /dev/urandom | base64 | tr -d '/+=' | head -c 44

# Cifra en reposo la semilla del segundo factor (AES-256-GCM, userId como dato
# asociado). Minimo 32 caracteres. Rotarla obliga a REENROLAR a todo el mundo.
TOTP_ENCRYPTION_KEY=

# Pimienta HMAC de las contrasenas y clave base del HMAC con que se guardan los
# codigos del correo. Minimo 32. Perderla teniendo contrasenas creadas obliga a
# restablecerlas todas.
PASSWORD_PEPPER=
