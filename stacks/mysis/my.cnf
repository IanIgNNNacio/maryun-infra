# MariaDB de MySis en maryun01.
#
# Se monta en /etc/mysql/conf.d/maryun.cnf. Lo que va en la línea de comandos
# del compose son los cuatro ajustes que cambian el rendimiento y que conviene
# ver de un vistazo al abrir el compose; lo que va aquí es lo que hay que
# explicar.
#
# EN AZURE NO HAY NINGÚN AJUSTE PROPIO. El único archivo con contenido es
# 50-server.cnf de Debian, con cuatro líneas: bind-address, expire_logs_days y
# el juego de caracteres. Todo lo demás es el valor por defecto del paquete —
# incluido un innodb_buffer_pool_size de 128 MB para una base de 12 GiB.

[mysqld]

# ── El juego de caracteres, que es lo que puede corromper datos ──────────────
#
# 163 de las 168 tablas son latin1_spanish_ci, 4 son utf8mb4_general_ci y 1 es
# utf8mb4_unicode_ci. El servidor de Azure anuncia utf8mb4, el cliente negocia
# utf8mb3 por defecto, y `mysqli_set_charset($con, "utf8")` está COMENTADO en
# conectar.php: la aplicación no fija nada y hereda lo que las dos puntas
# acuerden.
#
# Funciona hoy porque ambas puntas están configuradas igual. Aquí se reproduce
# EXACTAMENTE la misma configuración, no la «correcta»: cambiarla a utf8mb4 en
# el servidor sin tocar las tablas ni la aplicación es como se corrompen los
# acentos de forma silenciosa y sólo se descubre meses después, mirando datos
# viejos que ya nadie puede reconstruir.
#
# Normalizar a utf8mb4 de verdad —convertir las 163 tablas y descomentar el
# set_charset— es un trabajo aparte, con su propia prueba y su propio respaldo.
# Fase 5, no durante la mudanza.
character-set-server = utf8mb4
collation-server     = utf8mb4_general_ci

# ── Registro binario ────────────────────────────────────────────────────────
#
# En Azure log_bin está APAGADO. Eso significa que hoy no hay forma de
# recuperar a un instante: si alguien borra una tabla a las 15:00, lo último que
# hay es el volcado de las 02:30.
#
# Aquí se enciende. No es capricho: es lo mismo que sostiene el PITR del ERP, y
# el coste es unos pocos GB de disco en una máquina con 429 libres. Con esto, un
# error humano deja de costar medio día de trabajo.
#
# ROW y no STATEMENT: la aplicación usa NOW() y funciones no deterministas por
# todas partes, y con STATEMENT eso se reproduce mal.
log_bin                = /var/lib/mysql/binlog
binlog_format          = ROW
expire_logs_days       = 10
max_binlog_size        = 256M

# ── Consultas lentas: apagado, igual que en Azure ───────────────────────────
#
# Se deja como está allá para no cambiar dos cosas a la vez. Cuando toque mirar
# el rendimiento —fase 5— se enciende con long_query_time = 0.5 y se apaga
# después: dejarlo puesto penaliza cada consulta y llena el disco.
slow_query_log = 0

# ── Lo que NO se cambia, y por qué ──────────────────────────────────────────
#
# sql_mode se deja en el valor de Azure. La aplicación tiene veinte años de
# INSERT escritos contra él; endurecerlo aquí haría fallar cosas que hoy pasan.
sql_mode = STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION

# lower_case_table_names se queda en 0 —nombres sensibles a mayúsculas—, que es
# lo que hay en Azure. Cambiarlo con la base ya creada la rompe.
lower_case_table_names = 0

# innodb_file_per_table ya viene en ON y así se queda: con 168 tablas y una de
# ellas de 2,8 GB, un tablespace único haría imposible recuperar espacio.
innodb_file_per_table = 1

# innodb_flush_log_at_trx_commit = 1 es el valor de Azure y el seguro: cada
# commit va al disco. Bajarlo a 2 daría más velocidad de escritura a cambio de
# poder perder un segundo de transacciones en un corte. En un sistema que emite
# documentos tributarios, no.
innodb_flush_log_at_trx_commit = 1
