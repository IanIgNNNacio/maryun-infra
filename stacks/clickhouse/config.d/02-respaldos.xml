<clickhouse>
    <!-- Disco dedicado a respaldos. Permite usar el comando BACKUP nativo, que
         toma una instantanea consistente de la base en uso — copiar los archivos
         de /var/lib/clickhouse en caliente puede dar un estado a medias. -->
    <storage_configuration>
        <disks>
            <backups>
                <type>local</type>
                <path>/backups/</path>
            </backups>
        </disks>
    </storage_configuration>
    <backups>
        <allowed_disk>backups</allowed_disk>
        <allowed_path>/backups/</allowed_path>
    </backups>
</clickhouse>
