[Unit]
Description=Temporizador del refresco de preview

[Timer]
# DIARIO, no cada hora. Preview vive en su propia instancia de PostgreSQL sin
# archivado, asi que ya no ensucia el WAL de produccion; pero recrear 265 MB
# tampoco hace falta 24 veces al dia. El objetivo es tener datos recientes para
# probar, no un espejo al minuto.
#
# 05:10 UTC: despues del respaldo diario (03:15) y del diferencial del PITR
# (04:30), antes de mysis_full_reload_tab_cmp (05:30).
OnCalendar=*-*-* 05:10:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
